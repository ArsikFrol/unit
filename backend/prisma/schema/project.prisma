enum Status {
    COMPLETED
    IN_DEVELOPMENT
}

model Project {
    projectId String @id @default(cuid()) @map("project_id")

    status      Status @default(IN_DEVELOPMENT)
    imageLogo   String @map("image_logo")
    title       String
    description String

    link    String
    bgColor String @map("bg_color")

    startOfDevelopment DateTime  @map("start_of_development")
    endOfDevelopment   DateTime? @map("end_of_development")

    technologies ProjectTechnology[]
    creators     ProjectCreator[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("projects")
}

model ProjectTechnology {
    projectId String  @map("project_id")
    project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

    technologyId String     @map("technology_id")
    technology   Technology @relation(fields: [technologyId], references: [technologyId], onDelete: Cascade)

    @@id([projectId, technologyId])
    @@index([technologyId])
}

model ProjectCreator {
    projectId String  @map("project_id")
    project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

    creatorId String  @map("creator_id")
    creator   Creator @relation(fields: [creatorId], references: [creatorId], onDelete: Cascade)

    @@id([projectId, creatorId])
    @@index([creatorId])
}
